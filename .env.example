# Copy to .env for local development. Values below are local-only examples.
APP_BASE_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:5173
DJANGO_SECRET_KEY=local-development-secret-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
SESSION_COOKIE_AGE=28800
LEARNER_SESSION_AGE=2592000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.16.0.0/12
ACCESS_TOKEN_PEPPER=local-access-pepper-change-before-use
SESSION_TOKEN_PEPPER=local-session-pepper-change-before-use
DEVICE_CHALLENGE_TTL_SECONDS=300
RECOVERY_TOKEN_TTL_SECONDS=900
RECOVERY_REQUEST_IP_LIMIT=5
RECOVERY_REQUEST_EMAIL_LIMIT=3
RECOVERY_REQUEST_RATE_WINDOW_SECONDS=3600
ACCESS_AUTH_RATE_LIMIT=20
ACCESS_AUTH_RATE_WINDOW_SECONDS=60
HEARTBEAT_RATE_LIMIT=1
HEARTBEAT_RATE_WINDOW_SECONDS=5
PWA_TRANSFER_PEPPER=local-pwa-transfer-pepper-change-before-use
PWA_TRANSFER_TTL_SECONDS=600
PWA_TRANSFER_MAX_ATTEMPTS=5
PWA_TRANSFER_RATE_LIMIT=12
PWA_TRANSFER_RATE_WINDOW_SECONDS=300
DATABASE_URL=postgresql://learning:learning@postgres:5432/learning
POSTGRES_DB=learning
POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=learning-platform
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=minio-local-secret
MINIO_KMS_SECRET_KEY=local-kms-key:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
S3_USE_SSL=false
S3_CHECKSUM_POLICY_SUPPORTED=false
MEDIA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_AUDIO_MAX_BYTES=262144000
MEDIA_VIDEO_MAX_BYTES=5368709120
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_FFPROBE_TIMEOUT_SECONDS=30
MEDIA_TRANSFER_MODE=proxy
S3_CHECKSUM_POLICY_SUPPORTED=false
MEDIA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@learning.local
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Leave both key values empty in DEBUG; Compose supplies the development pair.
# Production requires a matching private PKCS8 PEM (base64) and public P-256 JWK.
OFFLINE_LICENSE_SIGNING_PRIVATE_KEY_B64=
OFFLINE_LICENSE_TTL_HOURS=24
VITE_ENABLE_SERVICE_WORKER=true
VITE_OFFLINE_LICENSE_PUBLIC_JWK=
MEDIA_GET_URL_TTL_SECONDS=60
MEDIA_UPLOAD_URL_TTL_SECONDS=600
MEDIA_IMAGE_MAX_BYTES=20971520
MEDIA_AUDIO_MAX_BYTES=262144000
MEDIA_VIDEO_MAX_BYTES=5368709120
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_FFPROBE_TIMEOUT_SECONDS=30
