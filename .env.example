# Copy to .env for local development. Values below are local-only examples.
APP_BASE_URL=http://localhost:8000
DJANGO_SECRET_KEY=local-development-secret-change-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
ACCESS_TOKEN_PEPPER=local-access-pepper-change-before-use
SESSION_TOKEN_PEPPER=local-session-pepper-change-before-use
DATABASE_URL=postgresql://learning:learning@postgres:5432/learning
POSTGRES_DB=learning
POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=learning-platform
S3_ACCESS_KEY_ID=minio-local
S3_SECRET_ACCESS_KEY=minio-local-secret
S3_USE_SSL=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@learning.local
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
OFFLINE_LICENSE_SIGNING_PRIVATE_KEY=not-used-until-iteration-1.4
OFFLINE_LICENSE_SIGNING_PUBLIC_KEY=not-used-until-iteration-1.4
OFFLINE_LICENSE_TTL_HOURS=24
MEDIA_GET_URL_TTL_SECONDS=60
MEDIA_UPLOAD_URL_TTL_SECONDS=600
